---
import '@/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Larisken.id - Solusi Praktis Jualan Online",
  description = "Solusi praktis jualan online. Bikin web toko sendiri, order otomatis masuk ke aplikasi, hitung ongkir otomatis, tracing order, dan pembayaran langsung ke tokomu tanpa potongan komisi!"
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="larisken, toko online umkm, jualan online, web toko sendiri, order otomatis aplikasi, hitung ongkir otomatis, food delivery umkm" />
    
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://larisken.id/" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-primary/20 selection:text-primary">
    <slot />
  </body>
</html>

