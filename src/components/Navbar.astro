---
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { Store, Smartphone, ArrowRight, Menu, X } from '@lucide/astro';
---

<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="flex size-9 items-center justify-center rounded-lg bg-primary text-primary-foreground font-black text-lg shadow-sm transition-transform group-hover:scale-105">
        L
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight text-foreground flex items-center">
          Larisken<span class="text-primary font-black">.id</span>
        </span>
      </div>
    </a>

    <!-- Nav links Desktop -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-muted-foreground">
      <a href="#keunggulan" class="transition-colors hover:text-foreground">Keunggulan</a>
      <a href="#cara-kerja" class="transition-colors hover:text-foreground">Cara Kerja</a>
      <a href="#fitur" class="transition-colors hover:text-foreground">Fitur</a>
      <a href="#simulasi-ongkir" class="transition-colors hover:text-foreground">Simulasi Ongkir</a>
      <a href="https://demo.larisken.id" target="_blank" rel="noopener noreferrer" class="transition-colors text-primary font-semibold hover:text-primary/80 flex items-center gap-1">
        <span>Demo</span>
        <span class="text-[10px] bg-primary/10 text-primary px-1.5 py-0.5 rounded-full font-bold">Live</span>
      </a>
      <a href="#faq" class="transition-colors hover:text-foreground">FAQ</a>
    </nav>

    <!-- Right Actions Desktop -->
    <!-- Mobile Menu Button (Accessible toggle) -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle Menu"
      class="inline-flex md:hidden size-9 items-center justify-center rounded-md border border-input bg-background text-foreground shadow-sm hover:bg-accent"
    >
      <Menu id="icon-menu" class="size-5" />
      <X id="icon-close" class="size-5 hidden" />
    </button>
  </div>

  <!-- Mobile Drawer Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-border bg-background px-4 py-4 space-y-3">
    <nav class="flex flex-col gap-3 text-sm font-medium text-muted-foreground">
      <a href="#keunggulan" class="px-2 py-1.5 rounded-md hover:bg-accent hover:text-foreground">Keunggulan</a>
      <a href="#cara-kerja" class="px-2 py-1.5 rounded-md hover:bg-accent hover:text-foreground">Cara Kerja</a>
      <a href="#fitur" class="px-2 py-1.5 rounded-md hover:bg-accent hover:text-foreground">Fitur</a>
      <a href="#simulasi-ongkir" class="px-2 py-1.5 rounded-md hover:bg-accent hover:text-foreground">Simulasi Ongkir</a>
      <a href="https://demo.larisken.id" target="_blank" rel="noopener noreferrer" class="px-2 py-1.5 rounded-md text-primary font-bold hover:bg-primary/10 flex items-center justify-between">
        <span>Coba Demo Toko</span>
        <span class="text-[10px] bg-primary text-primary-foreground px-1.5 py-0.5 rounded-full">Live</span>
      </a>
      <a href="#faq" class="px-2 py-1.5 rounded-md hover:bg-accent hover:text-foreground">FAQ</a>
    </nav>
    <div class="pt-2 flex flex-col gap-2">
      <Button variant="outline" as="a" href="#aplikasi" class="w-full justify-center">
        <Smartphone data-icon="inline-start" />
        Login Toko
      </Button>
      <Button as="a" href="#daftar" class="w-full justify-center">
        Buka Toko Gratis Sekarang
      </Button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>

