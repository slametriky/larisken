---
import Card from '@/components/ui/Card.astro';
import CardHeader from '@/components/ui/CardHeader.astro';
import CardTitle from '@/components/ui/CardTitle.astro';
import CardDescription from '@/components/ui/CardDescription.astro';
import CardContent from '@/components/ui/CardContent.astro';
import CardFooter from '@/components/ui/CardFooter.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { Store, ExternalLink, ArrowRight, Sparkles, MapPin } from '@lucide/astro';

const samplePartners = [
  {
    name: "Dapur Pak Slamet",
    category: "Kuliner & Ayam Bakar",
    subdomain: "dapurpakslamet.larisken.id",
    specialty: "Ayam Bakar Madu, Geprek Sambal Matah",
    initial: "P",
    color: "bg-emerald-600 text-white"
  },
  {
    name: "Kopi Seduh Berkah",
    category: "Kopi & Minuman",
    subdomain: "kopiberkah.larisken.id",
    specialty: "Es Kopi Susu Gula Aren, Matcha Latte",
    initial: "K",
    color: "bg-amber-600 text-white"
  },
  {
    name: "Bakery Roti Mantap",
    category: "Roti & Pastry",
    subdomain: "rotimantap.larisken.id",
    specialty: "Roti Sobek Keju, Donat Kampung",
    initial: "R",
    color: "bg-orange-600 text-white"
  },
  {
    name: "Dimsum & Frozen Makmur",
    category: "Frozen Food & Camilan",
    subdomain: "frozenmakmur.larisken.id",
    specialty: "Dimsum Ayam Udang, Lumpia Kulit Tahu",
    initial: "D",
    color: "bg-teal-600 text-white"
  }
];
---

<section id="mitra" class="py-16 md:py-24 border-t border-border/60 bg-muted/30">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <Badge variant="secondary" class="mb-3">
        <Sparkles class="size-3.5 text-primary mr-1" /> Direktori Mitra Larisken.id
      </Badge>
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground">
        Otomatis Dipromosikan di List Mitra Terdaftar
      </h2>
      <p class="mt-4 text-sm sm:text-base text-muted-foreground leading-relaxed">
        Bukan hanya mendapat website toko sendiri, tokomu juga otomatis masuk ke dalam list mitra resmi di web <span class="font-semibold text-foreground">Larisken.id</span>. Pelanggan dapat langsung menemukan tokomu dan berbelanja!
      </p>
    </div>

    <!-- Partner Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {samplePartners.map((partner) => (
        <Card class="border-border bg-card flex flex-col justify-between hover:shadow-md transition-shadow">
          <CardHeader class="pb-3">
            <div class="flex items-center justify-between mb-3">
              <div class={`size-10 rounded-xl ${partner.color} flex items-center justify-center font-bold text-base shadow-sm`}>
                {partner.initial}
              </div>
              <Badge variant="outline" class="text-[10px] text-emerald-600 border-emerald-300 bg-emerald-50">
                ● Mitra Aktif
              </Badge>
            </div>
            <CardTitle class="text-base font-bold">{partner.name}</CardTitle>
            <CardDescription class="text-xs">{partner.category}</CardDescription>
          </CardHeader>
          
          <CardContent class="py-2 flex-1">
            <p class="text-xs text-muted-foreground line-clamp-2">
              <span class="font-medium text-foreground">Menu:</span> {partner.specialty}
            </p>
            <div class="mt-3 rounded-lg bg-muted/50 px-2.5 py-1.5 text-[11px] font-mono text-primary truncate">
              https://{partner.subdomain}
            </div>
          </CardContent>

          <CardFooter class="pt-3 border-t border-border/60">
            <Button variant="ghost" size="sm" as="a" href="#daftar" class="w-full justify-between text-xs font-semibold text-primary hover:text-primary">
              <span>Buka Toko Seperti Ini</span>
              <ArrowRight data-icon="inline-end" />
            </Button>
          </CardFooter>
        </Card>
      ))}
    </div>

    <!-- Banner Callout Below Grid -->
    <div class="mt-10 rounded-xl border border-primary/20 bg-primary/5 p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="font-bold text-sm sm:text-base text-foreground">
          Ingin tokomu tampil di list mitra terdaftar ini?
        </h4>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Daftar sekarang, gratis 1 bulan pertama dan toko Anda langsung dipromosikan di portal Larisken.id.
        </p>
      </div>
      <Button as="a" href="#daftar" class="shrink-0 shadow-sm">
        Daftarkan Tokomu Sekarang
        <ArrowRight data-icon="inline-end" />
      </Button>
    </div>

  </div>
</section>

