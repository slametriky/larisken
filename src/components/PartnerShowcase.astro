---
import Card from '@/components/ui/Card.astro';
import CardHeader from '@/components/ui/CardHeader.astro';
import CardTitle from '@/components/ui/CardTitle.astro';
import CardDescription from '@/components/ui/CardDescription.astro';
import CardContent from '@/components/ui/CardContent.astro';
import CardFooter from '@/components/ui/CardFooter.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { ExternalLink, ArrowRight, Sparkles, MapPin, Tag } from '@lucide/astro';
import { getFeaturedPartners } from '@/lib/partners';

const partners = await getFeaturedPartners();
---

{partners.length > 0 && (
  <section id="mitra" class="py-16 md:py-24 border-t border-border/60 bg-muted/30">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          Mitra Larisken
        </h2>
      </div>

      <!-- Partner Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {partners.map((partner) => {
          const storeUrl = `https://${partner.slug}.larisken.id`;
          const initial = partner.name?.charAt(0) || 'T';
          const isImageLogo = partner.logo && partner.logo.startsWith('http');
          
          return (
            <Card class="border-border bg-card flex flex-col justify-between hover:shadow-lg transition-all duration-200 group text-center p-6">
              <div>
                <!-- Centered & Larger Logo -->
                <div class="mx-auto mb-5 size-24 rounded-2xl bg-muted/60 border border-border/80 flex items-center justify-center overflow-hidden shadow-xs group-hover:scale-105 transition-transform">
                  {isImageLogo ? (
                    <img 
                      src={partner.logo!} 
                      alt={partner.name} 
                      class="size-full object-cover" 
                      loading="lazy"
                    />
                  ) : partner.logo ? (
                    <span class="text-4xl">{partner.logo}</span>
                  ) : (
                    <div class="size-full bg-primary/10 text-primary font-black text-3xl flex items-center justify-center">
                      {initial}
                    </div>
                  )}
                </div>

                <!-- Store Name -->
                <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors tracking-tight">
                  {partner.name}
                </h3>

                <!-- Tagline -->
                <p class="text-xs text-muted-foreground line-clamp-2 min-h-[34px] mt-1.5 leading-relaxed">
                  {partner.tagline || 'Toko online resmi mitra Larisken.id'}
                </p>

                <!-- Kota & Kategori Badges (di bawah tagline) -->
                <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5">
                  {partner.city && (
                    <span class="inline-flex items-center gap-1 rounded-md bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                      <MapPin class="size-3 text-primary shrink-0" />
                      <span>{partner.city}</span>
                    </span>
                  )}
                  {partner.business_category && (
                    <span class="inline-flex items-center gap-1 rounded-md bg-primary/10 px-2 py-0.5 text-[11px] font-semibold text-primary">
                      <Tag class="size-3 shrink-0" />
                      <span>{partner.business_category}</span>
                    </span>
                  )}
                </div>
              </div>

              <!-- Action Link directly to Web Toko -->
              <div class="mt-6 pt-4 border-t border-border/60">
                <a 
                  href={storeUrl}
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-primary/10 py-2.5 text-xs font-bold text-primary hover:bg-primary hover:text-primary-foreground transition-all duration-200 group/btn"
                >
                  <span>Kunjungi Web Toko</span>
                  <ExternalLink class="size-3.5 group-hover/btn:translate-x-0.5 transition-transform" />
                </a>
              </div>
            </Card>
          );
        })}
      </div>

      <!-- Banner Callout Below Grid -->
      <div class="mt-12 rounded-2xl border border-primary/20 bg-primary/5 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h4 class="font-bold text-foreground text-sm sm:text-base">Ingin tokomu tampil di halaman utama Larisken.id?</h4>
          <p class="text-xs sm:text-sm text-muted-foreground">Daftarkan tokomu sekarang dan dapatkan website siap pakai dalam hitungan menit.</p>
        </div>
        <Button size="sm" as="a" href="/daftar" class="shrink-0 font-semibold shadow-xs">
          <span>Buka Toko Sekarang</span>
          <ArrowRight data-icon="inline-end" />
        </Button>
      </div>

    </div>
  </section>
)}
