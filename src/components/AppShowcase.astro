---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { 
  Smartphone, 
  Volume2, 
  ClipboardList, 
  TrendingUp, 
  Check, 
  ArrowRight,
  ShieldCheck
} from '@lucide/astro';
---

<section id="aplikasi" class="py-16 md:py-24">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copywriting -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-semibold text-primary">
          <Smartphone class="size-3.5" />
          <span>Aplikasi Toko Larisken</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-tight">
          Login ke Aplikasi Toko, Kelola Pesanan Langsung di HP Anda
        </h2>

        <p class="text-base text-muted-foreground leading-relaxed">
          Setelah toko Anda terdaftar, cukup login ke Aplikasi Toko Larisken dengan akun Anda. Setiap ada pembeli checkout dari link web tokomu, aplikasi langsung berbunyi kencang agar pesanan siap segera Anda terima dan proses!
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-3">
            <div class="size-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <Volume2 class="size-4" />
            </div>
            <div>
              <h4 class="font-bold text-sm text-foreground">Alarm Notifikasi Pesanan Masuk</h4>
              <p class="text-xs text-muted-foreground">Nada dering khusus yang berbunyi seketika saat ada order baru, langsung siap diproses dapur.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="size-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <ClipboardList class="size-4" />
            </div>
            <div>
              <h4 class="font-bold text-sm text-foreground">Update Status Pesanan 1-Klik</h4>
              <p class="text-xs text-muted-foreground">Pantau rincian pesanan, catatan pembeli, dan ubah status pesanan (diproses / siap antar) dengan mudah di layar HP.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="size-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <TrendingUp class="size-4" />
            </div>
            <div>
              <h4 class="font-bold text-sm text-foreground">Rekap Omset Otomatis</h4>
              <p class="text-xs text-muted-foreground">Pantau total penjualan harian, menu terlaris, dan rekap ongkos kirim tanpa perlu pembukuan manual.</p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <Button size="lg" as="a" href="#daftar">
            Daftar Sekarang
            <ArrowRight data-icon="inline-end" />
          </Button>
        </div>
      </div>

      <!-- Right Column: Visual App Screen Mockup -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="w-full max-w-sm rounded-[2.5rem] border-4 border-foreground/10 bg-card p-4 shadow-2xl ring-1 ring-black/5 relative">
          <!-- Phone Speaker notch -->
          <div class="mx-auto h-4 w-32 rounded-full bg-muted/80 mb-4"></div>

          <!-- App Header -->
          <div class="flex items-center justify-between pb-3 border-b border-border mb-4">
            <div class="flex items-center gap-2">
              <div class="size-7 rounded-md bg-primary text-primary-foreground font-black text-xs flex items-center justify-center">L</div>
              <div>
                <span class="font-bold text-xs text-foreground block leading-none">Aplikasi Toko Larisken</span>
                <span class="text-[10px] text-muted-foreground">Akun: Dapur Pak Slamet</span>
              </div>
            </div>
            <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full">
              ● Toko Buka
            </span>
          </div>

          <!-- Active Order Card inside App -->
          <div class="space-y-3">
            <div class="rounded-xl border border-primary/30 bg-primary/5 p-3.5 space-y-2 relative">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold text-primary">Pesanan Aktif (Dapur)</span>
                <span class="text-[10px] text-muted-foreground">14:20 WIB</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-bold text-sm text-foreground">3x Ayam Bakar Madu</span>
                <span class="font-extrabold text-sm text-foreground">Rp 69.000</span>
              </div>
              <div class="flex items-center justify-between text-xs text-muted-foreground pt-1 border-t border-primary/10">
                <span>Ongkir (2.1 km):</span>
                <span class="font-semibold text-primary">Rp 7.000</span>
              </div>
              <div class="flex items-center justify-between text-xs pt-1">
                <span class="text-xs font-semibold text-foreground">Status Kurir:</span>
                <span class="text-xs font-bold text-emerald-600">Siap Diantar</span>
              </div>
              <div class="pt-2">
                <button class="w-full py-2 rounded-md bg-primary text-[11px] font-bold text-primary-foreground hover:bg-primary/90 cursor-pointer">
                  Terima & Siapkan Pesanan
                </button>
              </div>
            </div>

            <!-- Stats Mini Card -->
            <div class="rounded-xl border border-border bg-muted/30 p-3 flex justify-between items-center text-xs">
              <div>
                <p class="text-muted-foreground">Omset Hari Ini</p>
                <p class="text-base font-extrabold text-foreground">Rp 1.450.000</p>
              </div>
              <div class="text-right">
                <p class="text-muted-foreground">Pesanan Selesai</p>
                <p class="text-base font-extrabold text-primary">24 Order</p>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-border flex justify-around text-muted-foreground text-[10px]">
            <span class="font-bold text-primary">Pesanan</span>
            <span>Menu & Stok</span>
            <span>Pengaturan Ongkir</span>
            <span>Laporan</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

